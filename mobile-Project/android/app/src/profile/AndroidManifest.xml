<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Em desenvolvimento o backend-Project roda em http://10.0.2.2:3004 (a
         maquina host, vista de dentro do emulador). O Android 9+ bloqueia
         trafego em texto claro por padrao, entao a excecao vale SOMENTE para as
         variantes debug e profile - a variante release continua exigindo HTTPS,
         que e o que a secao 7 do .IA/CONTEXT.md pede em producao. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
