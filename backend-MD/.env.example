# ============================================================================
# backend-MD — motor de IA / Mineração de Dados
# Copie este arquivo para .env e preencha os valores. NUNCA versione o .env.
# ============================================================================

PORT=3003
NODE_ENV=development
API_VERSION=0.0.1

# --- Banco de dados ---------------------------------------------------------
# Mesmo cluster MongoDB do backend-Project, em DATABASE DISTINTO (seção 12):
# dado técnico de ML separado do dado de negócio. Acesso exclusivamente via Prisma.
DB_PORT=27017
DB_URL=mongodb+srv://username:password@cluster-name.mongodb.net/Mongo-PI-Backend-MD?retryWrites=true&w=majority

# --- Autenticação intra-serviço (seção 11.1) --------------------------------
# Segredo compartilhado com o backend-Project. Deve ser IDÊNTICO ao MD_API_KEY
# configurado lá. É a única credencial deste serviço: não há autenticação de
# usuário final aqui (isso é responsabilidade do backend-Project).
# Gerar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MD_API_KEY=

# --- CORS -------------------------------------------------------------------
# Vazio = nenhuma origem de navegador liberada, que é o padrão desejado: nenhum
# front-end deve chamar este serviço diretamente. Preencher apenas se houver
# necessidade real (lista separada por vírgula).
CORS_ORIGINS=

# --- Camada de ML (Python) --------------------------------------------------
# O Express aciona o Python via child_process (decisão registrada na seção 6).
# PYTHON_BIN vazio = detecta automaticamente ML/.venv e cai para "python" do PATH.
PYTHON_BIN=
# Tempo máximo de execução de um script Python por requisição.
ML_TIMEOUT_MS=30000
# Máximo de registros aceitos em POST /api/classify/batch.
ML_MAX_BATCH_SIZE=500
# Quantos processos Python podem rodar ao mesmo tempo. Cada chamada a
# /classify ou /classify/batch sobe um interpretador novo
# (importa sklearn/pandas/numpy do zero); sem limite, um pico de requisições
# simultâneas pode competir por CPU/memória e estourar ML_TIMEOUT_MS por causa
# da concorrência, não da carga real de cada chamada. Vazio = (núcleos da CPU - 1).
ML_MAX_CONCURRENCY=

# --- Mensageria — Kafka REST (Aiven) -----------------------------------------
# Consome pedidos de análise em lote em KAFKA_TOPIC_ANALYSIS_REQUESTED e
# publica o resultado em KAFKA_TOPIC_ANALYSIS_COMPLETED.
# A comunicação usa a API REST do Kafka (Karapace) do Aiven: HTTPS + Basic Auth,
# sem conexão TCP direta ao broker. Credenciais em Aiven > serviço Kafka >
# "Apache Kafka REST" (Service URI, User, Password). Os dois backends usam as
# MESMAS credenciais e os MESMOS tópicos, mas grupos de consumo DIFERENTES.
# Os tópicos não são criados pelo código (a API REST não permite): crie-os no
# console do Aiven antes de ligar a mensageria.
# false (ou ausente) = mensageria desligada; o serviço atende apenas pela API HTTP.
KAFKA_ENABLED=false
KAFKA_REST_URL=https://kafka-xxxxxxx-projeto.x.aivencloud.com:12345
KAFKA_REST_USERNAME=avnadmin
KAFKA_REST_PASSWORD=
KAFKA_TOPIC_ANALYSIS_REQUESTED=pae.analysis.requested
KAFKA_TOPIC_ANALYSIS_COMPLETED=pae.analysis.completed
# Grupo de consumo deste serviço — precisa ser diferente do usado no backend-Project.
KAFKA_CONSUMER_GROUP=backend-md
