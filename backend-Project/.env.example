# ============================================================================
# backend-Project — API principal e núcleo de negócio
# Copie este arquivo para .env e preencha os valores. NUNCA versione o .env.
# ============================================================================

PORT=3004
NODE_ENV=development
API_VERSION=0.0.1

# --- Banco de dados ---------------------------------------------------------
# Mesmo cluster MongoDB do backend-MD, em DATABASE DISTINTO (seção 6):
# dado de negócio separado do dado técnico de ML. Acesso exclusivamente via Prisma.
DB_PORT=27017
DB_URL=mongodb+srv://username:password@cluster-name.mongodb.net/Mongo-PI-Backend-Project?retryWrites=true&w=majority

# --- Autenticação de usuários — JWT (seção 11.1) ----------------------------
# Gerar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token: 1d, 12h, 7d...
AUTH_EXPIRES=1d
# Custo do hash bcrypt. Maior = mais seguro e mais lento no login.
BCRYPT_ROUNDS=10

# --- Integração com o backend-MD (seção 11.2) -------------------------------
# Endereço do serviço de IA e o segredo compartilhado. MD_API_KEY deve ser
# IDÊNTICO ao configurado no backend-MD. Somente este serviço conhece essa URL —
# o front-end nunca acessa o backend-MD diretamente.
MD_API_BASE_URL=http://localhost:3003/api/
MD_API_KEY=
# Tempo máximo de espera pelo serviço de IA. Precisa ser maior que o
# ML_TIMEOUT_MS do backend-MD, que ainda executa o processo Python.
MD_TIMEOUT_MS=40000

# --- CORS -------------------------------------------------------------------
# Origens dos clientes, separadas por vírgula. O Vite usa DUAS portas diferentes:
#   5173 -> npm run dev      (servidor de desenvolvimento)
#   4173 -> npm run preview  (pré-visualização do build de produção)
# São origens distintas para o navegador; faltar uma delas causa erro de CORS no
# preflight. Em produção, troque pela origem real do Front-End.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- E-mail (recuperação de senha — somente usuários do papel VIEWER) -------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_here

# URL do Front-End Web, usada para montar o link de recuperação de senha
# enviado por e-mail (ex.: https://app.exemplo.com em produção).
FRONTEND_URL=http://localhost:5173
